# Explicitly force LF line endings for shell scripts, gradlew, and Kotlin source
gradlew text eol=lf
*.sh text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.toml text eol=lf

# Explicitly force CRLF for Windows batch scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Auto detect line endings for all other text files
* text=auto
